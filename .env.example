# Backend settings (copy to backend/.env for local development)
APP_DATABASE_URL=sqlite+aiosqlite:///./data/app.db
APP_CHROMA_PERSIST_DIRECTORY=./data/chroma
APP_CHROMA_COLLECTION_NAME=document_chunks
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_SQL_ECHO=false
APP_GROQ_API_KEY=your_groq_api_key_here
APP_GEMINI_API_KEY=your_gemini_api_key_here
APP_GROQ_MODEL=llama-3.3-70b-versatile
APP_GEMINI_MODEL=gemini-3.8-flash
APP_UPLOAD_MAX_BYTES=20971520
APP_CHUNK_SIZE=2000
APP_CHUNK_OVERLAP=200

# Frontend setting (copy to frontend/.env.local for local development)
VITE_API_BASE_URL=http://localhost:8000
